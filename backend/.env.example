HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/gestaocarreira
# Redis e opcional. Deixe vazio para processar sem fila.
REDIS_URL=
# Se o backend e o Redis rodam diretamente na mesma VM:
# REDIS_URL=redis://localhost:6379/0
# Se o Redis tem senha:
# REDIS_URL=redis://:SUA_SENHA@localhost:6379/0
# Se o backend roda no Docker Compose junto com o servico redis:
# REDIS_URL=redis://redis:6379/0
# Optional: only needed for direct cross-origin browser calls.
# If empty, the backend falls back to FRONTEND_BASE_URL for CORS.
CORS_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
STORAGE_LOCAL_DIR=backend/storage_data
STORAGE_HISTORICO_PREFIX=historicofuncional
STORAGE_AFASTAMENTOS_PREFIX=afastamentos
AUTO_SYNC_DB_SCHEMA=false
SECRET_KEY=troque-esta-chave-local
EMAIL_CONFIRMATION_SUBJECT=Confirme seu cadastro no Career Flow
EMAIL_RECOVERY_SUBJECT=Redefina sua senha no Career Flow
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@exemplo.com
SMTP_PASSWORD=sua_senha_ou_app_password
SMTP_FROM_EMAIL=seuemail@exemplo.com
SMTP_FROM_NAME=Career Flow
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
EMAIL_PROVIDER=auto
RESEND_FROM_EMAIL=Gestao de Carreira <no-reply@seu-dominio.com>
