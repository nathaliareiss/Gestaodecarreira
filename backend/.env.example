SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_HISTORICO_PREFIX=historicofuncional
SUPABASE_STORAGE_AFASTAMENTOS_PREFIX=afastamentos
AUTO_SYNC_DB_SCHEMA=false
